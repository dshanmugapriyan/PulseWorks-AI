# Copy to `.env` to override the dashboard defaults.

# Application
VITE_APP_NAME=PulseWorks AI

# System banner
VITE_SYSTEM_BANNER_ENABLED=true
VITE_SYSTEM_BANNER_DEFAULT_LEVEL=operational
VITE_SYSTEM_BANNER_POLL_INTERVAL_MS=30000
VITE_SYSTEM_BANNER_DISMISSIBLE=true

# Task form
VITE_DEFAULT_MAX_TOKENS=16384

